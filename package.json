{
  "name": "openrouter-json-prompt-loader",
  "private": true,
  "version": "0.1.0",
  "description": "Gera especificações técnicas e prompts estruturados a partir de tarefas usando modelos gratuitos do OpenRouter.",
  "author": "Allan Kevin Scain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllanKevinScain/openrouter-json-prompt-loader.git"
  },
  "homepage": "https://github.com/AllanKevinScain/openrouter-json-prompt-loader#readme",
  "bugs": {
    "url": "https://github.com/AllanKevinScain/openrouter-json-prompt-loader/issues"
  },
  "keywords": [
    "openrouter",
    "prompt",
    "json",
    "react",
    "vite",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --config .prettierrc.cjs --write \"src/**/*.ts\" --ignore-path .prettierignore"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.62.11",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.54.2",
    "react-json-view-lite": "^2.5.0",
    "safira-ui": "^3.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
